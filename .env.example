# Databas (SQLite-fil; byt till postgresql://… och provider i schema.prisma för Postgres)
# I drift: lägg till ?socket_timeout=15 (väntetid vid upptagen databas, se fly.toml)
DATABASE_URL="file:./dev.db"

# Seed – adminlösenord för Anders (endast lokal utveckling)
SEED_ADMIN_PASSWORD="anders2026"

# Datakälla för tabell/skytteliga/assistliga: "espn" (standard, ingen nyckel) eller "api-football"
FOOTBALL_PROVIDER="espn"
# API-Football (https://dashboard.api-football.com) – valfri, faller tillbaka till ESPN vid fel
API_FOOTBALL_KEY=""
# TheSportsDB (spelarfoton) – tomt = publik testnyckel
THESPORTSDB_KEY=""

# The Odds API (https://the-odds-api.com) – odds för seriesegrare (valfritt)
ODDS_API_KEY=""
ODDS_OUTRIGHT_SPORT="soccer_sweden_allsvenskan_winner"

# Nyhetsflöden (RSS), kommaseparerade. Tomt = Google News "Allsvenskan"
NEWS_FEEDS=""

# Web Push – generera med: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:anders@allsvenskantipset.se"

# Skyddar /api/cron/* (synk & påminnelser). Anropa med header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="byt-mig"

# IP-huvud som din proxy sätter (används för inloggningsspärren). Fly.io: "fly-client-ip". Tomt = sista ledet i X-Forwarded-For.
TRUSTED_IP_HEADER=""

# Backup. Kontrollerade kopior tas nattligen och runt deadline och ligger i BACKUP_DIR (standard: mappen "backups" bredvid databasen).
BACKUP_DIR=""
# Lösenfras (minst 16 tecken) för den krypterade nedladdningen /api/backup som off-site-backupen hämtar. Utan den är nedladdningen avstängd.
BACKUP_PASSPHRASE=""
